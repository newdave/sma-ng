#!/usr/bin/env bash
#MISE description="Run shellcheck -x over tracked shell scripts and .mise/tasks shell entrypoints"
set -euo pipefail

# Prefer the venv's pinned shellcheck-py (same version as the pre-commit hook)
# so local runs and CI agree; fall back to one on PATH.
SHELLCHECK="${VIRTUAL_ENV:-venv}/bin/shellcheck"
[ -x "$SHELLCHECK" ] || SHELLCHECK=$(command -v shellcheck || true)
[ -n "$SHELLCHECK" ] || {
  echo "shellcheck is not installed (mise run setup:deps:dev installs the pinned version)" >&2
  exit 2
}

files=()
while IFS= read -r f; do
  case "$f" in
    .claude/* | .codex/* | .agents/*) continue ;;
  esac
  [ -f "$f" ] || continue
  case "$f" in
    *.sh) files+=("$f") ;;
    .mise/tasks/*)
      # Only shell task scripts (skip any Python helpers kept in the tree).
      if head -n 1 "$f" | grep -Eq '^#!.*(ba|da|z)?sh'; then
        files+=("$f")
      fi
      ;;
  esac
done < <(git ls-files)

[ "${#files[@]}" -gt 0 ] || { echo "no shell scripts found" >&2; exit 2; }

# -P SCRIPTDIR resolves `source ../lib/x.sh` relative to each script.
"$SHELLCHECK" -x -P SCRIPTDIR "${files[@]}"
echo "shellcheck: ${#files[@]} files clean"

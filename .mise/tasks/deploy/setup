#!/usr/bin/env bash
#MISE description="Prepare remote Docker hosts: SSH key + ~/.ssh/config + ssh-copy-id, install Docker, create the install dir and seed config/logs/data"
#MISE depends=["deploy:check"]
set -euo pipefail

# shellcheck source=../../shared/deploy/lib.sh
# shellcheck disable=SC1091
source "$(dirname "$0")/../../shared/deploy/lib.sh"
ALL_HOSTS=$(lc deploy hosts "")

# If HOST is set (e.g. called as a recovery step from deploy:host), scope to
# that host only so we don't re-probe or re-prompt for unrelated hosts.
DEPLOY_HOSTS="${HOST:-$ALL_HOSTS}"

# ── 1. ensure SSH key exists ────────────────────────────────────────────────
key=$(lc deploy ssh_key "")
if [ -n "$key" ]; then
    keyfile=$(eval echo "$key")
    if [ ! -f "$keyfile" ]; then
        echo "==> SSH key $keyfile not found — generating ed25519 key"
        ssh-keygen -t ed25519 -f "$keyfile" -N "" -C "sma-deploy"
        echo "==> Generated $keyfile"
    else
        echo "==> SSH key $keyfile already exists"
    fi
else
    echo "==> No ssh_key configured, skipping key setup"
fi

# ── 2. add/update Host blocks in ~/.ssh/config ──────────────────────────────
sshcfg=~/.ssh/config
mkdir -p ~/.ssh && chmod 700 ~/.ssh
touch "$sshcfg" && chmod 600 "$sshcfg"

for host in $DEPLOY_HOSTS; do
    cfg="$CFG $LOCAL $host"
    port=$($cfg ssh_port 22)
    key=$($cfg ssh_key "")
    [ -z "$key" ] && continue
    keyfile=$(eval echo "$key")
    [ -f "$keyfile" ] || continue

    remote_user=$($cfg user "$(whoami)")
    remote_address=$($cfg address "")
    ssh_target="${remote_user}@${remote_address}"
    hostname="$remote_address"
    user="$remote_user"
    marker="# sma-deploy: $host"

    if grep -qsF "$marker" "$sshcfg"; then
        echo "==> [$host] ~/.ssh/config entry already present, skipping"
    else
        echo "==> [$host] adding Host block to $sshcfg"
        {
            printf '\n%s\n'           "$marker"
            printf 'Host %s\n'       "$hostname"
            [ -n "$user" ]         && printf '    User %s\n'        "$user"
            [ "$port" != "22" ]    && printf '    Port %s\n'        "$port"
            printf '    IdentityFile %s\n' "$keyfile"
            printf '    IdentitiesOnly yes\n'
        } >> "$sshcfg"
    fi
done

# ── 3. copy SSH key to each host ────────────────────────────────────────────
for host in $DEPLOY_HOSTS; do
    cfg="$CFG $LOCAL $host"
    port=$($cfg ssh_port 22)
    key=$($cfg ssh_key "")
    [ -z "$key" ] && continue
    keyfile=$(eval echo "$key")
    pubkey="$keyfile.pub"
    [ -f "$pubkey" ] || continue

    remote_user=$($cfg user "$(whoami)")
    remote_address=$($cfg address "")
    ssh_target="${remote_user}@${remote_address}"

    echo "==> [$host] copying SSH key (password prompt may follow)"
    ssh-copy-id -i "$pubkey" -p "$port" "$ssh_target"
done

# ── 4. install Docker via the Docker apt repo on each host ──────────────────
for host in $DEPLOY_HOSTS; do
    cfg="$CFG $LOCAL $host"
    port=$($cfg ssh_port 22)
    key=$($cfg ssh_key "")

    remote_user=$($cfg user "$(whoami)")
    remote_address=$($cfg address "")
    ssh_target="${remote_user}@${remote_address}"

    ssh_opts="-p $port -o BatchMode=yes -o StrictHostKeyChecking=accept-new"
    [ -n "$key" ] && ssh_opts="$ssh_opts -i $(eval echo "$key")"

    ensure_remote_docker "$host"
done

# ── 5. create the install dir and seed config/ logs/ data/ on each host ────
# The image carries the code; hosts only need the directories the compose file
# bind-mounts (deploy:docker pushes docker/, deploy:config pushes sma-ng.yml).
for host in $DEPLOY_HOSTS; do
    init_host_context "$host"
    ensure_remote_deploy_dir "$host"
    remote_user=$($cfg user "$(whoami)")
    install_dir=$($cfg sma_install_dir "/opt/sma")
    mk_ssh_opts "$($cfg ssh_port 22)" "$($cfg ssh_key "")"

    echo "==> [$host] seeding ${install_dir}/{config,logs,data} (owner: $remote_user)"
    # shellcheck disable=SC2029  # remote_user/install_dir expand client-side on purpose.
    ssh "${SSH_OPTS[@]}" "$ssh_target" "sudo mkdir -p '${install_dir}/config' '${install_dir}/logs' '${install_dir}/data' \
      && sudo chown -R '${remote_user}': '${install_dir}/config' '${install_dir}/logs' '${install_dir}/data'"
    # Seed daemon.env from the local sample only when the host has none.
    # shellcheck disable=SC2029
    ssh "${SSH_OPTS[@]}" "$ssh_target" "test -f '${install_dir}/config/daemon.env' \
      || sudo install -o '${remote_user}' -m 640 /dev/stdin '${install_dir}/config/daemon.env'" < setup/daemon.env.sample
    chown_remote_path_to_ssh_user "$host" "$install_dir"
done

#!/usr/bin/env bash
#MISE description="Cluster operations: mise run cluster -- <start|stop|restart|status|reload|drain|pause|resume|upgrade> (HOST or HOSTS to scope)"
set -euo pipefail

# One verb per former cluster:<verb> task. HOST/HOSTS selection is read by the shared helpers.
USAGE="usage: mise run cluster -- <start|stop|restart|status|reload|drain|pause|resume|upgrade>
  HOST=<host> or HOSTS='<a> <b>' scopes the hosts (default: deploy.hosts)"

verb="${1:-}"
case "$verb" in
  start | stop | restart | status | reload | drain | pause | resume | upgrade) ;;
  *)
    [ -z "$verb" ] || echo "ERROR: unknown cluster verb: $verb" >&2
    echo "$USAGE" >&2
    exit 2
    ;;
esac

# shellcheck disable=SC1091
source "$(dirname "$0")/../../shared/deploy/lib.sh"
# shellcheck disable=SC1091
source "$(dirname "$0")/../../shared/deploy/cluster_compose.sh"

case "$verb" in
  start) cluster_compose start "started" ;;
  stop) cluster_compose stop "stopped" ;;
  restart) cluster_compose restart "restarted" ;;
  status) cluster_compose ps "status checked" ;;
  reload)
    # shellcheck disable=SC1091
    source "$(dirname "$0")/../../shared/deploy/cluster_reload.sh"
    cluster_reload
    ;;
  upgrade)
    # shellcheck disable=SC1091
    source "$(dirname "$0")/../../shared/deploy/cluster_upgrade.sh"
    cluster_upgrade
    ;;
  drain | pause | resume)
    # shellcheck disable=SC1091
    source "$(dirname "$0")/../../shared/deploy/cluster_action.sh"
    cluster_action "$verb"
    ;;
esac

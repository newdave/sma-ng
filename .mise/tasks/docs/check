#!/usr/bin/env bash
#MISE description="Check docs: relative links resolve, every mise run reference is a real task, wiki pages render, markdownlint passes"
set -euo pipefail

cd "${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}"

"$PY" scripts/check_docs.py
"$PY" scripts/wiki_sync.py check
if command -v pre-commit >/dev/null 2>&1; then
  pre-commit run markdownlint-cli2 --all-files
else
  echo "pre-commit not installed; skipping markdownlint (mise run setup:deps:dev)" >&2
fi

# Docker Compose interpolation for docker-compose.yml (copy to docker/.env).
# install-smang.sh writes this file for you.
COMPOSE_PROFILES=software
IMAGE_TAG=latest
PORT=8585
# Intel/AMD GPU access is auto-configured at container start: the entrypoint
# stats the mapped /dev/dri device nodes and adds the runtime user to the
# matching host groups before dropping privileges. No RENDER_GID/VIDEO_GID
# tuning needed.

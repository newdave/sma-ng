{
  "permissions": {
    "allow": [
      "Bash(python manual.py*)",
      "Bash(python daemon.py*)",
      "Bash(curl*localhost*)",
      "Bash(pip install*)",
      "Bash(pip list*)",
      "Bash(ffmpeg -version)",
      "Bash(ffprobe -version)",
      "Bash(python -m pytest*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)"
    ],
    "deny": []
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/skill-reminder.sh claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/wiki-publish-after-push.sh",
            "timeout": 180,
            "statusMessage": "Checking whether the push needs a wiki publish"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$(git rev-parse --show-toplevel)/.plane/plane.sh\"; [ ! -f \"$f\" ] || bash \"$f\" session",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "codex@openai-codex": false,
    "code-simplifier@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": false
  },
  "ignorePaths": [
    "venv/**",
    "**/__pycache__/**",
    "*.pyc",
    "config/autoProcess.ini",
    "config/sma-ng.yml"
  ],
  "enabledMcpjsonServers": [
    "plane"
  ]
}

{
  "permissions": {
    "allow": [
      "Bash(python manual.py*)",
      "Bash(python daemon.py*)",
      "Bash(curl*localhost*)",
      "Bash(pip install*)",
      "Bash(pip list*)",
      "Bash(ffmpeg -version)",
      "Bash(ffprobe -version)",
      "Bash(python -m pytest*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)"
    ],
    "deny": []
  },
  "ignorePaths": [
    "venv/**",
    "**/__pycache__/**",
    "*.pyc",
    "config/autoProcess.ini",
    "config/sma-ng.yml"
  ],
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "bp@cc-blueprint-toolkit": false,
    "codex@openai-codex": false,
    "code-simplifier@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": false
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/claude-code/skill-reminder.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
